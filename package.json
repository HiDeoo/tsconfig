{
  "name": "@hideoo/tsconfig",
  "version": "2.0.4",
  "license": "MIT",
  "description": "HiDeoo's TypeScript configuration",
  "author": "HiDeoo <github@hideoo.dev> (https://hideoo.dev)",
  "main": "tsconfig.json",
  "scripts": {
    "lint": "prettier -c --cache .",
    "format": "prettier -w --cache .",
    "version": "pnpm changeset version && pnpm i --no-frozen-lockfile"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@hideoo/prettier-config": "^2.0.1",
    "prettier": "^3.9.6"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "tsconfig.json"
  ],
  "keywords": [
    "typescript",
    "config",
    "tsconfig",
    "ts"
  ],
  "homepage": "https://github.com/HiDeoo/tsconfig",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiDeoo/tsconfig.git"
  },
  "bugs": "https://github.com/HiDeoo/tsconfig/issues",
  "prettier": "@hideoo/prettier-config"
}
